{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "JOUW_APPLE_ID@voorbeeld.nl",
        "ascAppId": "VUL_APP_STORE_CONNECT_APP_ID_IN",
        "appleTeamId": "VUL_APPLE_TEAM_ID_IN"
      }
    }
  }
}
